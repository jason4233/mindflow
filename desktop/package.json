{
  "name": "mindflow-desktop",
  "version": "1.0.0",
  "description": "MindFlow Windows desktop application",
  "author": "jason4233",
  "type": "module",
  "main": "main.mjs",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "icon": "node scripts/build-icon.mjs",
    "start": "npm run icon && electron .",
    "build": "npm test && npm run icon && electron-builder --win nsis portable --x64",
    "smoke": "node scripts/smoke-portable.mjs"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3"
  },
  "build": {
    "appId": "com.mindflow.desktop",
    "productName": "MindFlow",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.mjs",
      "app-paths.mjs",
      "backup-store.mjs",
      "legacy-storage.mjs",
      "protocol.mjs",
      "window-focus.mjs",
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../index.html",
        "to": "app/index.html"
      },
      {
        "from": "../editor.html",
        "to": "app/editor.html"
      },
      {
        "from": "../assets",
        "to": "app/assets"
      },
      {
        "from": "../css",
        "to": "app/css"
      },
      {
        "from": "../js",
        "to": "app/js"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "MindFlow-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MindFlow",
      "uninstallDisplayName": "MindFlow"
    },
    "portable": {
      "artifactName": "MindFlow-portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
