<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup rules, referenced by android:dataExtractionRules.
  Only <exclude> rules are listed, so everything else Auto Backup normally covers
  (shared_prefs, files/, databases/, app_webview/ with the WebView localStorage)
  is still included. mindflow_secure.xml holds values encrypted with an Android
  Keystore key that is never backed up or transferred, so a restored copy would be
  undecryptable; it is excluded from both cloud backup and device-to-device transfer.
  Keep this file in sync with backup_rules.xml (Android 11 and older).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mindflow_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mindflow_secure.xml" />
    </device-transfer>
</data-extraction-rules>
